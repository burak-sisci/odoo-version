<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Powered by" the publisher under the notification e-mails. The unfollow
         link stays; mail.mail recognizes it by its id. -->
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout">
        <xpath expr="//span[@id='mail_unfollow']/.." position="replace">
            <div t-if="show_footer and show_unfollow" style="color: #555555; font-size:11px;">
                <span id="mail_unfollow">
                    <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                </span>
            </div>
        </xpath>
    </template>

    <template id="mail_notification_light" inherit_id="mail.mail_notification_light">
        <xpath expr="//span[@id='mail_unfollow']/../.." position="replace">
            <tr t-if="show_unfollow">
                <td align="center" style="min-width: 590px;">
                    <span id="mail_unfollow">
                        <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                    </span>
                </td>
            </tr>
        </xpath>
    </template>

    <!-- Page of the channels shared by link -->
    <template id="discuss_public_channel_template" inherit_id="mail.discuss_public_channel_template">
        <xpath expr="//title" position="attributes">
            <attribute name="t-out">title or ov_brand_name</attribute>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">x_icon or '/ov_brand/static/img/favicon.ico'</attribute>
        </xpath>
    </template>

</odoo>
