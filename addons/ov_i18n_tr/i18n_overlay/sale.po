"                                                                            "
"    </t>\n"
"                                                                            "
"</div>\n"
"                                                                        "
"</t>\n"
"                                                            </div>\n"
"                                                        </t>\n"
"                                                    <t "
"t-elif=\"not(combo_line.linked_line_id) and combo_line.id == line.id\">\n"
