"                                    <span "
"style=\"font-weight:bold;\">Billing</span>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td>\n"
"                                    <t "
"t-out=\"object.partner_invoice_id.street or ''\">1201 S Figueroa St</t><br/>\n"
"                                    <t "
"t-out=\"object.partner_invoice_id.city or ''\">Los Angeles</t>\n"
"                                    <t "
"t-out=\"object.partner_invoice_id.state_id.name or ''\">California</t>\n"
"                                    <t t-out=\"object.partner_invoice_id.zip "
