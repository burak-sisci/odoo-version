"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Sayın <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>\n"
"        <t t-if=\"object.partner_id.parent_id\">\n"
"            (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure "
"Interior</t>)\n"
"        </t>\n"
"        <br/><br/>\n"
"        Ekte şu teklif talebini bulabilirsiniz: <span "
"style=\"font-weight:bold;\" t-out=\"object.name or ''\">P00015</span>\n"
"        <t t-if=\"object.partner_ref\">\n"
"            — referansınız: <t t-out=\"object.partner_ref or ''\">REF_XXX</t>\n"
"        </t>\n"
"        — gönderen: <t t-out=\"object.company_id.name or "
"''\">YourCompany</t>.\n"
"        <br/><br/>\n"
"        Herhangi bir sorunuz olursa bizimle iletişime geçmekten çekinmeyin.\n"
"        <br/><br/>\n"
"        Saygılarımızla,\n"
"        <t t-if=\"not is_html_empty(object.user_id.signature)\">\n"
"            <br/><br/>\n"
"            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t "
"t-out=\"object.user_id.signature or ''\">Mitchell Admin</t></div>\n"
"        </t>\n"
"    </p>\n"
"</div>"

