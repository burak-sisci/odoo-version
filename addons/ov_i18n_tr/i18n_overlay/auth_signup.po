#. module: auth_signup
#: model:mail.template,body_html:auth_signup.mail_template_user_signup_account_created
msgid ""
"<t>\n"
"                        Dear <t t-out=\"object.name or ''\">Marc "
"Demo</t>,<br/><br/>\n"
"                        Your account has been successfully created!<br/>\n"
"                        Your login is <strong><t t-out=\"object.email or "
"''\">mark.brown23@example.com</t></strong><br/>\n"
"                        To gain access to your account, you can use the "
"following link:\n"
"                        <div style=\"margin: 32px 0px 32px 0px;\">\n"
"                            <a "
"t-attf-href=\"/web/login?auth_login={{object.email}}\" "
"t-attf-style=\"background-color: {{object.company_id.email_secondary_color "
"or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size:13px;\">\n"
"                                Go to My Account\n"
"                            </a>\n"
"                        </div>\n"
"                        Thanks,<br/>\n"
"                        <t t-if=\"user.signature\">\n"
"                            <br/>\n"
"                            <div data-o-mail-quote=\"1\">--<br "
"data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell "
"Admin</t></div>\n"
"                        </t>\n"
"                    </t>"
msgstr ""
"<t>\n"
"                        Sayın <t t-out=\"object.name or ''\">Marc "
"Demo</t>,<br/><br/>\n"
"                        Hesabınız başarıyla oluşturuldu!<br/>\n"
"                        Giriş adınız: <strong><t t-out=\"object.email or "
"''\">mark.brown23@example.com</t></strong><br/>\n"
"                        Hesabınıza erişmek için aşağıdaki bağlantıyı "
"kullanabilirsiniz:\n"
"                        <div style=\"margin: 32px 0px 32px 0px;\">\n"
"                            <a "
"t-attf-href=\"/web/login?auth_login={{object.email}}\" "
"t-attf-style=\"background-color: {{object.company_id.email_secondary_color "
"or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size:13px;\">\n"
"                                Hesabıma Git\n"
"                            </a>\n"
"                        </div>\n"
"                        Teşekkürler,<br/>\n"
"                        <t t-if=\"user.signature\">\n"
"                            <br/>\n"
"                            <div data-o-mail-quote=\"1\">--<br "
"data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell "
"Admin</t></div>\n"
"                        </t>\n"
"                    </t>"

#. module: auth_signup
#: model:mail.template,body_html:auth_signup.portal_set_password_email
msgid ""
"<t>\n"
"                Dear <t t-out=\"object.name or ''\">Marc Demo</t>,<br/> <br/>\n"
"                Welcome to <t "
"t-out=\"object.company_id.name\">YourCompany</t>'s Portal!<br/><br/>\n"
"                An account has been created for you with the following "
"login: <t t-out=\"object.login\">demo</t><br/><br/>\n"
"                Click on the button below to pick a password and activate "
"your account.\n"
"                <div style=\"margin: 16px 0px 16px 0px; text-align: "
"center;\">\n"
"                    <a t-att-href=\"object.partner_id._get_signup_url()\" "
"t-attf-style=\"display: inline-block; padding: 10px; text-decoration: none; "
"font-size: 12px; background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: "
"5px;\">\n"
"                        <strong>Activate Account</strong>\n"
"                    </a>\n"
"                </div>\n"
"                <t t-out=\"ctx.get('welcome_message') or ''\">Welcome to our "
"company's portal.</t>\n"
"            </t>"
msgstr ""
"<t>\n"
"                Sayın <t t-out=\"object.name or ''\">Marc Demo</t>,<br/> "
"<br/>\n"
"                <t t-out=\"object.company_id.name\">YourCompany</t> portalına "
"hoş geldiniz!<br/><br/>\n"
"                Sizin için şu giriş adıyla bir hesap oluşturuldu: <t "
"t-out=\"object.login\">demo</t><br/><br/>\n"
"                Bir parola seçip hesabınızı etkinleştirmek için aşağıdaki "
"düğmeye tıklayın.\n"
"                <div style=\"margin: 16px 0px 16px 0px; text-align: "
"center;\">\n"
"                    <a t-att-href=\"object.partner_id._get_signup_url()\" "
"t-attf-style=\"display: inline-block; padding: 10px; text-decoration: none; "
"font-size: 12px; background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: "
"5px;\">\n"
"                        <strong>Hesabı Etkinleştir</strong>\n"
"                    </a>\n"
"                </div>\n"
"                <t t-out=\"ctx.get('welcome_message') or ''\">Şirketimizin "
"portalına hoş geldiniz.</t>\n"
"            </t>"

#. module: auth_signup
#: model:mail.template,body_html:auth_signup.set_password_email
msgid ""
"<t>\n"
"<t t-set=\"company_name\" t-value=\"object.company_id.name or ''\"/>\n"
"<t t-set=\"website_url\" t-value=\"object.get_base_url()\"/>\n"
"Hi <t t-out=\"object.name or ''\">Marc Demo</t>,<br/><br/>\n"
"<em>This link is valid for <t "
"t-out=\"(object.env['ir.config_parameter'].sudo().get_int('auth_signup.signup.validity.hours') or 144)//24\">link_validity_days</t> days </em><br/>\n"
"<b><t t-out=\"company_name\"/></b> uses <a href=\"https://odoo.com\" "
"t-attf-style=\"color: {{object.company_id.email_secondary_color or "
"'#875A7B'}};\">Odoo</a>\n"
"to run its business. You have been invited by <b><t "
"t-out=\"object.create_uid.name or ''\">OdooBot</t></b> to connect.\n"
"<br/><br/>\n"
"Once accepted, you can reconnect through: <br/>\n"
"<ul>\n"
"    <li>Login: <a t-attf-href=\"/web/login?login={{ object.email }}\" "
"target=\"_blank\" t-out=\"object.email or "
"''\">mark.brown23@example.com</a></li>\n"
"    <li>Link: <a t-att-href=\"website_url\" t-out=\"website_url or "
"''\">http://yourcompany.odoo.com</a></li>\n"
"</ul>\n"
"<br/>\n"
"<div style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"object.partner_id._get_signup_url()\" "
"t-attf-style=\"background-color: {{object.company_id.email_secondary_color "
"or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size:13px;\">\n"
"        Accept invitation\n"
"    </a>\n"
"</div>\n"
"<br/>\n"
"Enjoy Odoo!<br/><br/>\n"
"--<br/>The <t t-out=\"company_name\"/> Team</t>\n"
"            "
msgstr ""
"<t>\n"
"<t t-set=\"company_name\" t-value=\"object.company_id.name or ''\"/>\n"
"<t t-set=\"website_url\" t-value=\"object.get_base_url()\"/>\n"
"Merhaba <t t-out=\"object.name or ''\">Marc Demo</t>,<br/><br/>\n"
"<em>Bu bağlantı <t "
"t-out=\"(object.env['ir.config_parameter'].sudo().get_int('auth_signup.signup.validity.hours') or 144)//24\">link_validity_days</t> gün geçerlidir </em><br/>\n"
"<b><t t-out=\"company_name\"/></b>, işlerini yürütmek için <a "
"href=\"https://odoo.com\" t-attf-style=\"color: "
"{{object.company_id.email_secondary_color or '#875A7B'}};\">Odoo</a>\n"
"kullanıyor. <b><t t-out=\"object.create_uid.name or ''\">OdooBot</t></b> sizi "
"bağlanmaya davet etti.\n"
"<br/><br/>\n"
"Daveti kabul ettikten sonra şuradan yeniden bağlanabilirsiniz: <br/>\n"
"<ul>\n"
"    <li>Giriş adı: <a t-attf-href=\"/web/login?login={{ object.email }}\" "
"target=\"_blank\" t-out=\"object.email or "
"''\">mark.brown23@example.com</a></li>\n"
"    <li>Bağlantı: <a t-att-href=\"website_url\" t-out=\"website_url or "
"''\">http://yourcompany.odoo.com</a></li>\n"
"</ul>\n"
"<br/>\n"
"<div style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"object.partner_id._get_signup_url()\" "
"t-attf-style=\"background-color: {{object.company_id.email_secondary_color "
"or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size:13px;\">\n"
"        Daveti kabul et\n"
"    </a>\n"
"</div>\n"
"<br/>\n"
"Odoo'nun keyfini çıkarın!<br/><br/>\n"
"--<br/><t t-out=\"company_name\"/> Ekibi</t>\n"
"            "

#. module: auth_signup
#: model:mail.template,body_html:auth_signup.mail_template_data_unregistered_users
msgid ""
"<t>\n"
"Dear <t t-out=\"object.name or ''\">Mitchell Admin</t>,<br/> <br/>\n"
"You added the following user(s) to your database but they haven't "
"registered yet:\n"
"<ul>\n"
"    <t t-foreach=\"invited_users\" t-as=\"invited_user\">\n"
"        <li t-out=\"invited_user or ''\">demo@example.com</li>\n"
"    </t>\n"
"</ul>\n"
"Follow up with them so they can access your database and start working with "
"you.\n"
"<br/><br/>\n"
"Have a nice day!<br/>\n"
"--<br/>The <t t-out=\"object.company_id.name or ''\">YourCompany</t> Team\n"
"            </t>"
msgstr ""
"<t>\n"
"Sayın <t t-out=\"object.name or ''\">Mitchell Admin</t>,<br/> <br/>\n"
"Veritabanınıza aşağıdaki kullanıcıları eklediniz, ancak henüz "
"kaydolmadılar:\n"
"<ul>\n"
"    <t t-foreach=\"invited_users\" t-as=\"invited_user\">\n"
"        <li t-out=\"invited_user or ''\">demo@example.com</li>\n"
"    </t>\n"
"</ul>\n"
"Veritabanınıza erişip sizinle çalışmaya başlayabilmeleri için onlarla "
"iletişime geçin.\n"
"<br/><br/>\n"
"İyi günler!<br/>\n"
"--<br/><t t-out=\"object.company_id.name or ''\">YourCompany</t> Ekibi\n"
"            </t>"

