#. module: account
#: model:mail.template,body_html:account.mail_template_data_payment_receipt
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear <t t-out=\"object.partner_id.name or ''\">Azure "
"Interior</t><br/><br/>\n"
"        <t t-if=\"object.partner_type == 'customer' and object.payment_type "
"== 'outbound'\">We have processed your refund of</t>\n"
"        <t t-elif=\"object.partner_type == 'supplier' and "
"object.payment_type == 'outbound'\">We have processed your payment of</t>\n"
"        <t t-elif=\"object.partner_type == 'supplier' and "
"object.payment_type == 'inbound'\">Thank you for your refund of</t>\n"
"        <t t-else=\"\">Thank you for your payment of</t> <span "
"style=\"font-weight:bold;\" t-out=\"format_amount(object.amount, "
"object.currency_id) or ''\">$ 10.00</span>.\n"
"        Please find the <t "
"t-out=\"object.payment_receipt_title.lower()\">payment receipt</t> <span "
"t-if=\"object.name\" style=\"font-weight:bold;\" "
"t-out=\"object.name.replace('/','-')\">BNK1-2021-05-0002</span> from <t "
"t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"        <br/><br/>\n"
"        Do not hesitate to contact us if you have any questions.\n"
"        <br/><br/>\n"
"        Best regards,\n"
"        <t t-if=\"not is_html_empty(user.signature)\">\n"
"            <br/><br/>\n"
"            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t "
"t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"        </t>\n"
"    </p>\n"
"</div>\n"
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Sayın <t t-out=\"object.partner_id.name or ''\">Azure "
"Interior</t><br/><br/>\n"
"        <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount, "
"object.currency_id) or ''\">$ 10.00</span> tutarındaki\n"
"        <t t-if=\"object.partner_type == 'customer' and object.payment_type "
"== 'outbound'\">iadenizi gerçekleştirdik.</t>\n"
"        <t t-elif=\"object.partner_type == 'supplier' and "
"object.payment_type == 'outbound'\">ödemenizi gerçekleştirdik.</t>\n"
"        <t t-elif=\"object.partner_type == 'supplier' and "
"object.payment_type == 'inbound'\">iadeniz için teşekkür ederiz.</t>\n"
"        <t t-else=\"\">ödemeniz için teşekkür ederiz.</t>\n"
"        <t t-out=\"object.company_id.name or ''\">YourCompany</t> firmasının "
"<span t-if=\"object.name\" style=\"font-weight:bold;\" "
"t-out=\"object.name.replace('/','-')\">BNK1-2021-05-0002</span> numaralı <t "
"t-out=\"object.payment_receipt_title.lower()\">payment receipt</t> belgesi "
"ektedir.\n"
"        <br/><br/>\n"
"        Herhangi bir sorunuz olursa bizimle iletişime geçmekten çekinmeyin.\n"
"        <br/><br/>\n"
"        Saygılarımızla,\n"
