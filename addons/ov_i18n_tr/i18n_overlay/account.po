"%(failed_count)s out of %(total_count)s entries could not be reset to draft."
msgstr "%(total_count)s kaydın %(failed_count)s tanesi taslağa döndürülemedi."

#. module: account
#. odoo-python
#: code:addons/account/models/account_bank_statement_line.py:0
msgid ""
"%(move)s reached an invalid state regarding its related bank transaction.\n"
"To be consistent, the journal entry must always have exactly one suspense "
"line."
msgstr ""
"%(move)s, ilgili banka işlemi açısından geçersiz bir duruma geldi.\n"
"Tutarlılık için yevmiye kaydında her zaman tam olarak bir geçici hesap "
"satırı bulunmalıdır."

#. module: account
#: model:ir.model.fields,field_description:account.field_res_company__vat_disabled_available
