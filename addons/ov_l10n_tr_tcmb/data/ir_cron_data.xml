<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- TCMB publishes around 15:30 Istanbul time (UTC+3); the job runs at 16:00. -->
        <record id="ir_cron_tcmb_rates" model="ir.cron">
            <field name="name">TCMB: Update exchange rates</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model._ov_tcmb_cron()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=13, minute=0, second=0) + timedelta(days=1 if DateTime.now().hour &gt;= 13 else 0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
