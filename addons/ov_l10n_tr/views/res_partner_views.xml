<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- In Turkey the district (ilçe) is chosen among the districts of the province (il):
         51 provinces have a district named "Merkez". -->
    <record id="res_partner_view_form_district" model="ir.ui.view">
        <field name="name">res.partner.form.ov_l10n_tr.district</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_address_extended.address_street_extended_city_form"/>
        <field name="arch" type="xml">
            <field name="city_id" position="attributes">
                <attribute name="domain">[('country_id', '=', country_id), ('state_id', '=?', country_code == 'TR' and state_id or False)]</attribute>
            </field>
            <xpath expr="//field[@name='child_ids']//form//field[@name='city_id']" position="attributes">
                <attribute name="domain">[('country_id', '=', country_id), ('state_id', '=?', country_code == 'TR' and state_id or False)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
