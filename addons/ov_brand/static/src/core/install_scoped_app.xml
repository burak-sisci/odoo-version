<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Publisher line under the app name, a link to odoo.com -->
    <t t-inherit="web.InstallScopedApp" t-inherit-mode="extension">
        <xpath expr="//a[@href='https://odoo.com']" position="replace"/>
    </t>

</templates>
