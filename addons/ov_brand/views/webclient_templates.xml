<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="layout" inherit_id="web.layout">
        <xpath expr="//title" position="attributes">
            <attribute name="t-out">title or ov_brand_name</attribute>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">x_icon or '/ov_brand/static/img/favicon.ico'</attribute>
        </xpath>
    </template>

    <template id="brand_promotion_message" inherit_id="web.brand_promotion_message">
        <xpath expr="//t[@t-set='odoo_logo']" position="replace">
            <t t-set="odoo_logo">
                <strong t-out="ov_brand_name"/>
            </t>
        </xpath>
    </template>

    <template id="login_layout" inherit_id="web.login_layout">
        <xpath expr="//a[starts-with(@href, 'https://www.odoo.com')]" position="replace">
            <span t-out="ov_brand_name"/>
        </xpath>
    </template>

    <!-- Link previews of /odoo URLs (login page with a redirect) -->
    <template id="login" inherit_id="web.login">
        <xpath expr="//meta[@property='og:site_name']" position="attributes">
            <attribute name="content"/>
            <attribute name="t-att-content">ov_brand_name</attribute>
        </xpath>
        <xpath expr="//meta[@property='og:title']" position="attributes">
            <attribute name="t-att-content">og_title if og_title != 'Odoo' else ov_brand_name</attribute>
        </xpath>
        <xpath expr="//meta[@name='twitter:title']" position="attributes">
            <attribute name="t-att-content">og_title if og_title != 'Odoo' else ov_brand_name</attribute>
        </xpath>
        <xpath expr="//meta[@property='og:image']" position="attributes">
            <attribute name="t-att-content">og_image_url.replace('/web/static/img/og_image.png', '/ov_brand/static/img/icon_512.png')</attribute>
        </xpath>
        <xpath expr="//meta[@name='twitter:image']" position="attributes">
            <attribute name="t-att-content">og_image_url.replace('/web/static/img/og_image.png', '/ov_brand/static/img/icon_512.png')</attribute>
        </xpath>
        <xpath expr="//meta[@property='og:image:width']" position="attributes">
            <attribute name="content">512</attribute>
        </xpath>
        <xpath expr="//meta[@property='og:image:height']" position="attributes">
            <attribute name="content">512</attribute>
        </xpath>
        <xpath expr="//meta[@name='twitter:card']" position="attributes">
            <attribute name="content">summary</attribute>
        </xpath>
        <!-- The slogan and the account belong to the upstream vendor -->
        <xpath expr="//meta[@property='og:description']" position="replace"/>
        <xpath expr="//meta[@property='og:image:alt']" position="replace"/>
        <xpath expr="//meta[@name='twitter:description']" position="replace"/>
        <xpath expr="//meta[@name='twitter:image:alt']" position="replace"/>
        <xpath expr="//meta[@name='twitter:site']" position="replace"/>
    </template>

    <template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap">
        <xpath expr="//meta[@name='theme-color']" position="attributes">
            <attribute name="content"/>
            <attribute name="t-att-content">ov_brand_color</attribute>
        </xpath>
        <xpath expr="//link[@rel='apple-touch-icon']" position="attributes">
            <attribute name="href">/ov_brand/static/img/icon_ios.png</attribute>
        </xpath>
    </template>

    <template id="webclient_offline" inherit_id="web.webclient_offline">
        <xpath expr="//style" position="after">
            <style>
                .card button {
                background-color: #1f5f8b;
                border-color: #1f5f8b;
                }
            </style>
        </xpath>
        <xpath expr="//div[hasclass('card')]/img" position="attributes">
            <attribute name="alt">Logo</attribute>
        </xpath>
        <xpath expr="//div[hasclass('card')]/p" position="replace">
            <p>Check your network connection and come back here. The application will load as soon as you're back online.</p>
        </xpath>
    </template>

</odoo>
